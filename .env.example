# --- Postgres ---
POSTGRES_USER=docuflow
POSTGRES_PASSWORD=docuflow
POSTGRES_DB=docuflow

# --- LLM ---
# MOCK_LLM=true permite construir todo el pipeline sin gastar tokens.
MOCK_LLM=true
# Tu key va SOLO aqui, en el .env local. Nunca en el repo.
ANTHROPIC_API_KEY=
EXTRACTION_MODEL=claude-haiku-4-5-20251001
ANSWER_MODEL=claude-sonnet-5

# Precios por millon de tokens. Consulta claude.com/pricing y llena estos
# valores; se usan solo para calcular el costo estimado en la tabla llm_calls.
# Formato JSON: {"nombre-modelo": precio}
PRICE_INPUT_PER_MTOK={}
PRICE_OUTPUT_PER_MTOK={}

# --- OCR ---
OCR_LANGUAGES=spa+eng
OCR_DPI=300

# --- Embeddings (locales, sin costo por token) ---
EMBEDDING_MODEL=intfloat/multilingual-e5-base
EMBEDDING_DIM=768
